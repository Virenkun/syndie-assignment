// PostgreSQL datasource and Lead model for Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id            Int            @id @default(autoincrement())
  name          String
  email         String
  phone         String?
  linkedin      String?
  company       String?
  notes         String?
  stage         String
  tags          String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
}

model Conversation {
  id           Int       @id @default(autoincrement())
  type         String    // email, call, linkedin, in_person
  content      String
  timestamp    DateTime  @default(now())
  followUpDate DateTime?
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId       Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}